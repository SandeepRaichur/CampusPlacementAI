# MongoDB Atlas connection string (or local mongodb://localhost:27017)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campus_placement?retryWrites=true&w=majority

# Google Gemini API Key for ATS Resume Parsing and AI Placement Assistant
GEMINI_API_KEY=your_gemini_api_key_here

# Database name (default: campus_placement)
DB_NAME=campus_placement

# Server Port (automatically set by Render/Railway/Heroku)
PORT=8000

# Allowed CORS origins (comma-separated, or * for all)
ALLOWED_ORIGINS=*
